# Google Service Account credentials (file path for local use)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json

# Inline service account JSON (used by GitHub Actions; keep unset locally if using file above)
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Target Google Sheet ID (populated automatically or printed by scripts/bootstrap_sheet.py)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TITLE=Hobby Collection DB

# Rakuten Ichiba API credentials (required for first-hand/sealed market prices)
RAKUTEN_APP_ID=
RAKUTEN_AFFILIATE_ID=

# Price refresh staleness threshold in days
STALE_DAYS=7

# Playwright authenticated browser storage state for Premium Bandai
PBANDAI_AUTH_STATE_PATH=.auth/pbandai_state.json
